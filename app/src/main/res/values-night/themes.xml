<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night (main app / bookshelf). System bars remain solid black everywhere,
         matching the day theme and the reader/settings chrome. -->
    <style name="Theme.EpubReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_muted</item>
        <item name="appColorBorder">@color/dark_border</item>
        <item name="appColorPop">@color/pop</item>
        <item name="appColorPop2">@color/pop2</item>
        <item name="appColorCoverPlaceholder">@color/cover_placeholder</item>
        <item name="appColorCoverText">@color/cover_text</item>
        <item name="appColorBadgeText">@color/dark_text</item>
        <item name="appColorProgressTrack">@color/progress_track</item>
        <item name="appColorProgressFill">@color/progress_fill</item>
        <item name="appColorCompleted">@color/completed</item>
        <item name="appColorReaderChromeScrim">@color/reader_chrome_scrim</item>
    </style>
</resources>
