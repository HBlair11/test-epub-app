<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/app_row_content_padding_h"
    android:layout_marginEnd="@dimen/app_row_content_padding_h"
    android:background="@drawable/toc_item_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingTop="10dp"
    android:paddingEnd="0dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/indent"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/reader_chrome_text"
        android:textSize="15sp" />
</LinearLayout>
