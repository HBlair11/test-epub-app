<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/homeEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="280dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.45"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_empty_title"
                android:textColor="?android:textColorPrimary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/home_empty_hint"
                android:textColor="?android:textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_import_file" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeContinueSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                android:text="@string/home_continue_heading"
                android:textColor="?android:textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/homeContinueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:id="@+id/homeContinueCover"
                        android:layout_width="94dp"
                        android:layout_height="141dp"
                        android:background="@drawable/cover_frame"
                        android:contentDescription="@string/book_cover"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/homeContinueTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="?android:textColorPrimary"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/homeContinueAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/homeContinueSeries"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/homeContinueLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/homeContinueProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="?android:textColorSecondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/homeContinueButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/continue_reading"
                        android:src="@drawable/ic_menu_book"
                        app:tint="?android:textColorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeRecentlyAddedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                android:text="@string/home_recently_added"
                android:textColor="?android:textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRecentlyAdded"
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/app_row_content_padding_h"
                android:paddingEnd="@dimen/app_row_content_padding_h"
                android:paddingTop="10dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeFavoritesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                android:text="@string/home_favorites"
                android:textColor="?android:textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeFavorites"
                android:layout_width="match_parent"
                android:layout_height="262dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/app_row_content_padding_h"
                android:paddingEnd="@dimen/app_row_content_padding_h"
                android:paddingTop="10dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeAuthorsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                android:text="@string/home_top_authors"
                android:textColor="?android:textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/homeAuthorGroup1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeAuthorTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeAuthorBooks1"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeAuthorGroup2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeAuthorTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeAuthorBooks2"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeAuthorGroup3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeAuthorTitle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeAuthorBooks3"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeSeriesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_row_content_padding_h"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/app_row_content_padding_h"
                android:text="@string/home_top_series"
                android:textColor="?android:textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/homeSeriesGroup1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeSeriesTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeSeriesBooks1"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeSeriesGroup2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeSeriesTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeSeriesBooks2"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeSeriesGroup3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeSeriesTitle3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_row_content_padding_h"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="@dimen/app_row_content_padding_h"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/homeSeriesBooks3"
                    android:layout_width="match_parent"
                    android:layout_height="262dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/app_row_content_padding_h"
                    android:paddingEnd="@dimen/app_row_content_padding_h"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
