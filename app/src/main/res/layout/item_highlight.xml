<?xml version="1.0" encoding="utf-8"?>
<!-- Patch v37: highlight list row. The text column uses width=0dp + weight=1 so
     the TextView fills the available width and wraps normally (the previous
     programmatic layout left the text at wrap_content inside a 0-width weighted
     column, which measured it against a 0-width constraint and stacked every
     character vertically). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/app_row_content_padding_h"
    android:paddingTop="@dimen/app_row_padding_v"
    android:paddingEnd="@dimen/app_row_content_padding_h"
    android:paddingBottom="@dimen/app_row_padding_v">

    <!-- Text column: color dot + highlight text + optional note. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:id="@+id/colorDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/highlightText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?android:textColorPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/highlightNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingTop="4dp"
            android:textColor="?android:textColorSecondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDelete"
        style="@style/EpubReaderIconButton"
        android:contentDescription="@string/highlight_delete"
        app:srcCompat="@drawable/ic_delete" />
</LinearLayout>
